# Copy this file to .env. Never commit .env.
AI_PROVIDER=agy

# Antigravity CLI provider: uses the locally authorized CLI account, never a browser token.
# Leave AGY_MODEL empty to use the CLI/account default. Supported effort values:
# low, medium, high, xhigh, max.
AGY_COMMAND=agy
AGY_MODEL=
AGY_EFFORT=low
AGY_TIMEOUT_MS=120000

# Alternative local provider: set AI_PROVIDER=ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Optional cloud provider. Set AI_PROVIDER=gemini to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional paid provider. Set AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
