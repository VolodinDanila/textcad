[textcad version=1 default-length=mm default-angle=deg]

; Demonstration dimensions, not a manufacturing drawing.
[param baseWidth 120mm]
[param baseDepth 80mm]
[param baseThickness 8mm]
[param wallWidth 100mm]
[param wallHeight 70mm]
[param wallThickness 8mm]
[param shaftRadius 18mm]
[param boltRadius 3mm]

[let baseProfile [sketch plane=XY
  [profile [rectangle origin=[-60mm -40mm] width=baseWidth height=baseDepth]]
]]
[let base [extrude baseProfile length=baseThickness]]
[let wallProfile [sketch plane=XZ origin=[0mm 40mm 8mm]
  [profile [rectangle origin=[-50mm 0mm] width=wallWidth height=wallHeight]]
]]
[let wall [extrude wallProfile length=wallThickness]]

; Two triangular ribs extend toward the front of the bracket.
[let gussetProfile [sketch plane=YZ origin=[-40mm 0mm 8mm]
  [profile [polygon [0mm 0mm] [32mm 0mm] [32mm 40mm]]]
]]
[let leftGusset [extrude gussetProfile length=6mm]]
[let gussets [pattern-linear leftGusset count=2 axis=X spacing=74mm]]
[let bracketBody [union base wall gussets]]

; Round the four vertical base corners, then re-select for later features.
[let rounded [fillet bracketBody
  edges=[edges bracketBody type=line axis=Z length=8mm] radius=2mm
]]

[let baseHoleProfile [sketch plane=XY origin=[-45mm -25mm -1mm]
  [profile [circle center=[0mm 0mm] radius=boltRadius]]
]]
[let baseHole [extrude baseHoleProfile length=10mm]]
[let baseHoleRow [pattern-linear baseHole count=2 axis=X spacing=90mm]]
[let baseHoles [pattern-linear baseHoleRow count=2 axis=Y spacing=50mm]]
[let baseDrilled [cut rounded baseHoles]]

[let shaftDrilled [hole baseDrilled
  origin=[0mm 41mm 48mm] axis=[0 -1 0] radius=shaftRadius depth=10mm
]]
[let motorHoleProfile [sketch plane=XZ origin=[-30mm 41mm 25mm]
  [profile [circle center=[0mm 0mm] radius=boltRadius]]
]]
[let motorHole [extrude motorHoleProfile length=10mm]]
[let motorHoleRow [pattern-linear motorHole count=2 axis=X spacing=60mm]]
[let motorHoles [pattern-linear motorHoleRow count=2 axis=Z spacing=46mm]]
[let drilledBracket [cut shaftDrilled motorHoles]]
[let finishedBracket [chamfer drilledBracket
  edges=[edges drilledBracket type=circle axis=Z extreme=min] distance=0.5mm
]]
[root finishedBracket label="Motor bracket"]
