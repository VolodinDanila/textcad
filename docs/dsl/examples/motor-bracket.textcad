; Design example for the direction after DSL v0.
; This file intentionally uses reserved commands that are not part of the
; first executable evaluator: box, cylinder, pattern-linear, union, cut,
; fillet, chamfer and selectors.

[textcad version=1 default-length=mm default-angle=deg]

[param baseWidth 120mm]
[param baseDepth 80mm]
[param baseThickness 8mm]
[param wallWidth 100mm]
[param wallHeight 70mm]
[param wallThickness 8mm]
[param shaftRadius 18mm]
[param boltRadius 3mm]

[let base
  [box
    size=[baseWidth baseDepth baseThickness]
    center=[0mm 0mm 4mm]
  ]
]

[let wall
  [box
    size=[wallWidth wallThickness wallHeight]
    center=[0mm 36mm 43mm]
  ]
]

[let gussetProfile
  [sketch plane=XZ origin=[-40mm 32mm 8mm]
    [profile role=outer
      [line start=[0mm 0mm] end=[30mm 0mm]]
      [line start=[30mm 0mm] end=[30mm 40mm]]
      [line start=[30mm 40mm] end=[0mm 0mm]]
    ]
  ]
]

[let leftGusset
  [extrude gussetProfile length=8mm symmetric=true]
]

[let gussets
  [pattern-linear
    leftGusset
    count=2
    direction=X
    spacing=50mm
  ]
]

[let bracketBody
  [union base wall gussets]
]

[let baseHole
  [cylinder
    radius=boltRadius
    height=baseThickness
    axis=Z
    center=[-45mm -25mm 4mm]
  ]
]

[let baseHoleRow
  [pattern-linear baseHole count=2 direction=X spacing=90mm]
]

[let baseHoles
  [pattern-linear baseHoleRow count=2 direction=Y spacing=50mm]
]

[let shaftHole
  [cylinder
    radius=shaftRadius
    height=wallThickness
    axis=Y
    center=[0mm 36mm 48mm]
    symmetric=true
  ]
]

[let motorBoltHole
  [cylinder
    radius=boltRadius
    height=wallThickness
    axis=Y
    center=[-30mm 36mm 25mm]
    symmetric=true
  ]
]

[let motorBoltRow
  [pattern-linear motorBoltHole count=2 direction=X spacing=60mm]
]

[let motorBoltHoles
  [pattern-linear motorBoltRow count=2 direction=Z spacing=46mm]
]

[let drilledBracket
  [cut bracketBody baseHoles shaftHole motorBoltHoles]
]

[let roundedBracket
  [fillet
    drilledBracket
    radius=3mm
    selector=[edges direction=Z convex=true]
  ]
]

[let finishedBracket
  [chamfer
    roundedBracket
    distance=0.8mm
    selector=[edges generated-by=baseHoles circular=true]
  ]
]

[root finishedBracket label="Motor bracket"]

